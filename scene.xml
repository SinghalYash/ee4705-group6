<mujoco model="manipulator_scene">
  <compiler angle="degree" coordinate="local" inertiafromgeom="true"/>
  <option gravity="0 0 -9.81" timestep="0.002"/>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="512"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.1 0.2 0.3" rgb2="0.2 0.3 0.4" width="512" height="512"/>
    <material name="grid" texture="grid" texrepeat="8 8" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light diffuse="0.8 0.8 0.8" pos="0 0 3" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="2 2 0.1" material="grid"/>

    <!-- Target area: flat red disc on the floor -->
    <geom name="target_area" type="cylinder" pos="0.5 0.5 0.001" size="0.15 0.001" rgba="1 0 0 0.5" contype="0" conaffinity="0"/>

    <!-- Task-relevant objects (free-floating so they can be picked up) -->
    <body name="stone" pos="0.4 -0.3 0.05">
      <freejoint/>
      <geom name="stone_geom" type="sphere" size="0.04" rgba="0.5 0.5 0.5 1" mass="0.05" friction="1 0.5 0.1"/>
    </body>

    <body name="box_obj" pos="0.5 -0.1 0.04">
      <freejoint/>
      <geom name="box_geom" type="box" size="0.04 0.04 0.04" rgba="0 0 1 1" mass="0.05" friction="1 0.5 0.1"/>
    </body>

    <body name="cylinder_obj" pos="0.3 0.1 0.05">
      <freejoint/>
      <geom name="cylinder_geom" type="cylinder" size="0.03 0.05" rgba="0 1 0 1" mass="0.05" friction="1 0.5 0.1"/>
    </body>

    <!-- Simple 4-DOF arm with a 2-finger parallel gripper -->
    <body name="base" pos="0 0 0.1">
      <geom type="cylinder" size="0.05 0.05" rgba="0.3 0.3 0.3 1"/>
      <body name="link1" pos="0 0 0.05">
        <joint name="shoulder_pan" type="hinge" axis="0 0 1" range="-180 180" damping="2" armature="0.05"/>
        <geom type="capsule" fromto="0 0 0 0 0 0.2" size="0.03" rgba="0.8 0.2 0.2 1"/>
        <body name="link2" pos="0 0 0.2">
          <joint name="shoulder_lift" type="hinge" axis="0 1 0" range="-90 90" damping="2" armature="0.05"/>
          <geom type="capsule" fromto="0 0 0 0.25 0 0" size="0.03" rgba="0.8 0.4 0.2 1"/>
          <body name="link3" pos="0.25 0 0">
            <joint name="elbow" type="hinge" axis="0 1 0" range="-150 150" damping="1.5" armature="0.03"/>
            <geom type="capsule" fromto="0 0 0 0.2 0 0" size="0.025" rgba="0.8 0.6 0.2 1"/>
            <body name="wrist" pos="0.2 0 0">
              <joint name="wrist_pitch" type="hinge" axis="0 1 0" range="-90 90" damping="1" armature="0.02"/>
              <geom type="capsule" fromto="0 0 0 0.05 0 0" size="0.02" rgba="0.5 0.5 0.5 1"/>
             
              <camera name="wrist_cam"
                    mode="targetbody"
                    target="wrist_camera_target"
                    pos="0.08 0 0.08"
                    fovy="75"/>           
            <!-- Invisible point that the wrist camera looks towards -->
              <body name="wrist_camera_target" pos="0.30 0 -0.25">
                  <geom type="sphere"
                        size="0.005"
                        rgba="1 1 1 0"/>
              </body>

              <body name="gripper_base" pos="0.08 0 0">
                <geom type="box" size="0.02 0.05 0.02" rgba="0.2 0.2 0.2 1"/>
      
       <!-- End-effector reference point for inverse kinematics; make invisible after testing --> 
                <site name="gripper_site"
                      pos="0 0 -0.025"
                      size="0.006"
                      rgba="1 0 1 1"/>
                   <!-- Centre where a grasped object should sit -->
                <site name="grasp_site"
                      pos="0 0 -0.05"
                      size="0.008"
                      rgba="0 1 1 1"/>

                <body name="finger_left" pos="0 0.03 0">
                  <joint name="finger_left_joint" type="slide" axis="0 1 0" range="0 0.04" damping="5" armature="0.01"/>
                  <geom type="box" size="0.01 0.01 0.03" rgba="0.1 0.1 0.1 1" friction="1.5 0.5 0.1"/>
                </body>
                <body name="finger_right" pos="0 -0.03 0">
                  <joint name="finger_right_joint" type="slide" axis="0 -1 0" range="0 0.04" damping="5" armature="0.01"/>
                  <geom type="box" size="0.01 0.01 0.03" rgba="0.1 0.1 0.1 1" friction="1.5 0.5 0.1"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- Fixed overhead camera covering the whole scene -->
    <camera name="overhead_cam" pos="0.4 0.1 1.3" euler="0 0 0" fovy="60"/>
  </worldbody>

  <actuator>
    <position name="act_shoulder_pan" joint="shoulder_pan" kp="50" kv="8" ctrlrange="-3.14 3.14"/>
    <position name="act_shoulder_lift" joint="shoulder_lift" kp="50" kv="8" ctrlrange="-1.57 1.57"/>
    <position name="act_elbow" joint="elbow" kp="50" kv="6" ctrlrange="-2.6 2.6"/>
    <position name="act_wrist_pitch" joint="wrist_pitch" kp="30" kv="4" ctrlrange="-1.57 1.57"/>
    <position name="act_finger_left" joint="finger_left_joint" kp="200" kv="10" ctrlrange="0 0.04"/>
    <position name="act_finger_right" joint="finger_right_joint" kp="200" kv="10" ctrlrange="0 0.04"/>
  </actuator>
</mujoco>
